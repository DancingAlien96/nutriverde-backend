# --- Server ---
NODE_ENV=development
PORT=4001
# Orígenes permitidos por CORS. Acepta:
# - URL única                "https://nutriverde.com"
# - Lista separada por comas "http://localhost:3000,https://nutriverde.com"
# - Wildcard de subdominio   "https://*.vercel.app"
# - "*"                      cualquier origen (no recomendado con credentials)
FRONTEND_ORIGIN=http://localhost:3000

# --- Database (MySQL en Docker) ---
# El docker-compose.yml usa estas variables para inicializar el contenedor.
# Si cambias algo aquí, recuerda recrear el contenedor:
#   docker compose down -v && docker compose up -d
MYSQL_ROOT_PASSWORD=nutriverde_dev
MYSQL_DATABASE=nutriverde
MYSQL_USER=nutriverde
MYSQL_PASSWORD=nutriverde_dev
# Si ya tienes otro MySQL corriendo en 3306, cambia ambos valores (ej. 3307)
# y actualiza DATABASE_URL para que apunte al mismo puerto.
MYSQL_PORT=3306
ADMINER_PORT=8080

# Cadena de conexión usada por Prisma (apunta al contenedor expuesto en localhost)
DATABASE_URL="mysql://nutriverde:nutriverde_dev@localhost:3306/nutriverde"

# --- Auth ---
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=7d

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Correo ---
# smtp | resend. En desarrollo, "smtp" sin credenciales imprime el correo en
# consola en vez de enviarlo.
MAIL_PROVIDER=smtp
# Obligatoria si MAIL_PROVIDER=resend (el backend no arranca sin ella).
RESEND_API_KEY=

# --- SMTP (Gmail) ---
# Para Gmail necesitas una "App Password": https://myaccount.google.com/apppasswords
# (requiere 2FA activado en la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-16-caracteres
MAIL_FROM="Plenha Nutrition <tu-correo@gmail.com>"

# --- Negocio ---
BUSINESS_TIMEZONE=America/Guatemala
