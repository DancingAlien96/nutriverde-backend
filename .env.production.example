# =========================================================================
# NutriVerde — plantilla del .env de PRODUCCIÓN
#
# Copia este archivo como `.env` EN EL SERVIDOR y rellena los valores.
# NO reutilices el .env de desarrollo: sus secretos son públicos (están en
# .env.example, que vive en el repo).
# =========================================================================

# --- Server ---
NODE_ENV=production
PORT=4001

# Origen(es) del frontend para CORS. Acepta lista separada por comas.
# Debe incluir exactamente el dominio desde el que se sirve el sitio.
FRONTEND_ORIGIN=https://www.plenhanutrition.com,https://plenhanutrition.com

# --- Base de datos ---
# Estas cuatro variables las consume docker-compose.prod.yml para inicializar
# MySQL y para construir DATABASE_URL. Genera contraseñas nuevas:
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nutriverde
MYSQL_USER=nutriverde
MYSQL_PASSWORD=

# DATABASE_URL la sobrescribe el compose apuntando al contenedor `mysql`.
# Se deja declarada porque config/env.ts la exige al validar el entorno.
DATABASE_URL="mysql://nutriverde:CAMBIAME@mysql:3306/nutriverde"

# --- Auth ---
# OBLIGATORIO cambiarlo. El valor de .env.example es público: con él
# cualquiera puede firmar un token de admin válido.
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Plenha Nutrition <citas@plenhanutrition.com>"

# --- Negocio ---
BUSINESS_TIMEZONE=America/Guatemala

# =========================================================================
# Checklist post-deploy (no son variables, son pasos):
#
#   1. Cambiar la contraseña del admin. El seed crea
#      admin@nutriverde.local / ChangeMe123!, y ese valor está en el repo.
#   2. Programar ./docker/backup.sh en cron.
#   3. Configurar el dominio api.plenhanutrition.com en Dokploy (el TLS y el
#      certificado los gestiona su Traefik; este compose no expone puertos).
# =========================================================================
