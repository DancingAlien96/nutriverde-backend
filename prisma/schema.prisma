// NutriVerde — Prisma schema
// Modelo de dominio para sistema de consultas nutricionales online

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Usuarios administradores (la nutricionista y posible staff)
// ============================================================
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(NUTRITIONIST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  approvedPayments Payment[] @relation("PaymentApprover")
  reminders        Reminder[]

  @@map("admin_users")
}

// ============================================================
// Recordatorios / tareas del panel admin (por usuario)
// ============================================================
model Reminder {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  text      String    @db.Text
  done      Boolean   @default(false)
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([adminId])
  @@map("reminders")
}

enum DocumentType {
  DPI       // Guatemala
  CURP      // México
  PASSPORT  // Pasaporte internacional
  OTHER     // Otro tipo de documento
}

enum AdminRole {
  NUTRITIONIST
  STAFF
}

// ============================================================
// Pacientes (referidos por link privado)
// ============================================================
model Patient {
  id              String   @id @default(cuid())
  fullName        String
  email           String   @unique
  // Documento de identidad. La API exige el campo en el intake.
  // Tipo configurable porque hay pacientes de varios países:
  //   DPI      Guatemala (13 dígitos)
  //   CURP     México (18 alfanuméricos)
  //   PASSPORT Cualquier país
  //   OTHER    cualquier otro identificador
  documentId      String?       @unique
  documentType    DocumentType  @default(DPI)
  phone           String?
  whatsappNotify  Boolean  @default(false)
  timezone        String   @default("America/Guatemala")
  referralSource  String?  // quién lo refirió (texto libre opcional)
  notes           String?  @db.Text

  // --- Datos clínicos (que la nutricionista llena en consulta inicial) ---
  birthDate          DateTime?
  heightCm           Int?     // estatura en cm (170 = 1.70m)
  allergies          String?  @db.Text
  medicalConditions  String?  @db.Text
  medications        String?  @db.Text
  alcoholNotes       String?
  cravingsNotes      String?
  waterCoffeeNotes   String?
  dislikedFoods      String?  @db.Text
  weekendSpots       String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  intakeForms     IntakeForm[]
  payments        Payment[]
  appointments    Appointment[]
  nutritionPlans  NutritionPlan[]
  diagnoses       PatientDiagnosis[]
  trainings       PatientTraining[]
  measurements    AnthropometricMeasurement[]
  mealPlans       MealPlan[]

  @@index([email])
  @@map("patients")
}

// ============================================================
// Datos clínicos por consulta (historial)
// ============================================================

/// Objetivos y metas del paciente. Cada entrada es una "captura" — la nutricionista
/// puede actualizar y queda el historial.
model PatientDiagnosis {
  id              String   @id @default(cuid())
  patientId       String
  objective       String?  @db.Text
  goalFatPercent  Float?
  goalFatLossLbs  Float?
  goalLeanMassKg  Float?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_diagnoses")
}

/// Plan de entrenamiento (gimnasio/actividad física).
model PatientTraining {
  id        String   @id @default(cuid())
  patientId String
  duration  String?
  frequency String?
  schedule  String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_trainings")
}

/// Mediciones antropométricas — una por visita. La "tabla de citas" de la hoja
/// de consulta inicial.
model AnthropometricMeasurement {
  id                String   @id @default(cuid())
  patientId         String
  appointmentId     String?
  measuredAt        DateTime @default(now())
  visitNumber       Int?     // #1, #2... opcional, solo de referencia

  // Composición corporal
  weightKg          Float?
  fatPercent        Float?
  waterPercent      Float?
  leanMassKg        Float?
  metabolicAge      Int?
  visceralFat       Int?
  caliperFatPercent Float?

  // Circunferencias (cm)
  chestCm           Float?
  waistCm           Float?
  abdomenCm         Float?
  hipCm             Float?
  armCm             Float?
  thighCm           Float?
  calfCm            Float?

  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([measuredAt])
  @@map("anthropometric_measurements")
}

/// Plan alimentario estructurado (5 comidas). Es distinto de NutritionPlan
/// (que es el PDF entregable). Aquí va la estructura editable.
model MealPlan {
  id              String   @id @default(cuid())
  patientId       String
  title           String?
  breakfast       String?  @db.Text
  morningSnack    String?  @db.Text
  lunch           String?  @db.Text
  afternoonSnack  String?  @db.Text
  dinner          String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("meal_plans")
}

// ============================================================
// Servicios ofrecidos (Consulta Inicial, Seguimiento, Premium)
// ============================================================
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique  // "consulta-inicial", "seguimiento", "premium"
  name        String
  description String   @db.Text
  // Traducciones auto-generadas al guardar (overlay EN/ES). `name`/`description`
  // siguen siendo el texto fuente que escribió el admin.
  nameEn        String?
  nameEs        String?
  descriptionEn String? @db.Text
  descriptionEs String? @db.Text
  imageUrl      String?            // imagen pública del servicio (/uploads/services/..)
  priceCents  Int                  // precio Guatemala en centavos GTQ (Q350.00 -> 35000)
  priceUsdCents Int?               // precio internacional en centavos USD (US$69 -> 6900)
  currency    String   @default("GTQ")
  durationMin Int                  // duración en minutos (0 si es mensual)
  billingType BillingType @default(ONE_TIME)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  payments     Payment[]

  @@map("services")
}

enum BillingType {
  ONE_TIME
  MONTHLY
}

// ============================================================
// Formulario inicial del paciente (datos básicos + objetivos)
// ============================================================
model IntakeForm {
  id          String   @id @default(cuid())
  patientId   String
  serviceSlug String                // qué servicio quiere
  // Datos estructurados libres (objetivos, condiciones, historial)
  data        Json
  submittedAt DateTime @default(now())

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("intake_forms")
}

// ============================================================
// Pagos (comprobante manual, aprobación por la nutricionista)
// ============================================================
model Payment {
  id            String        @id @default(cuid())
  patientId     String
  serviceId     String
  appointmentId String?       @unique  // se vincula tras crear la cita
  amountCents   Int
  currency      String        @default("GTQ")
  receiptUrl    String        // ruta al comprobante subido
  receiptMime   String?
  status        PaymentStatus @default(PENDING_REVIEW)
  approvedById  String?
  approvedAt    DateTime?
  rejectedReason String?      @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service     Service      @relation(fields: [serviceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  approvedBy  AdminUser?   @relation("PaymentApprover", fields: [approvedById], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ============================================================
// Citas (consultas online por Google Meet/Zoom)
// ============================================================
model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  serviceId      String
  scheduledAt    DateTime?         // null hasta que el paciente seleccione horario
  durationMin    Int
  timezone       String            @default("America/Guatemala")
  status         AppointmentStatus @default(AWAITING_PAYMENT)
  scheduleToken  String?           @unique  // token único para el link de auto-agenda
  meetingProvider MeetingProvider?
  meetingUrl     String?
  meetingId      String?
  remindersSent  Int               @default(0)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id])
  payment        Payment?
  nutritionPlan  NutritionPlan?

  @@index([patientId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

enum AppointmentStatus {
  AWAITING_PAYMENT
  PAYMENT_APPROVED
  PENDING_CONFIRMATION  // el paciente propuso una hora, falta que el admin la confirme + ponga el link
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum MeetingProvider {
  GOOGLE_MEET
  ZOOM
}

// ============================================================
// Disponibilidad de la nutricionista (slots configurables)
// ============================================================
model AvailabilitySlot {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0 = domingo, 6 = sábado
  startMinute Int      // minutos desde medianoche (ej. 09:00 = 540)
  endMinute   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("availability_slots")
}

// Configuración del scheduling (singleton: id = "default")
model SchedulingSettings {
  id                   String   @id @default("default")
  allowSameDayBooking  Boolean  @default(true)
  minLeadMinutes       Int      @default(60)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("scheduling_settings")
}

// ============================================================
// Datos bancarios para el pago (singleton, id = "default")
// Los edita la nutricionista desde el panel; el formulario de agendamiento
// los lee por un endpoint publico. Antes estaban escritos a mano en el
// frontend, asi que cambiarlos exigia redesplegar.
// ============================================================
model PaymentSettings {
  id            String   @id @default("default")
  bankName      String   @default("") // "Banrural", "BAM", ...
  accountType   String   @default("") // "Monetaria", "Ahorro"
  accountNumber String   @default("")
  accountHolder String   @default("")
  // Nota libre: SWIFT/IBAN para transferencias internacionales, horarios de
  // acreditacion, o cualquier instruccion extra. Se muestra tal cual.
  instructions  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payment_settings")
}

// Bloqueos puntuales (vacaciones, eventos)
model AvailabilityBlock {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt, endsAt])
  @@map("availability_blocks")
}

// ============================================================
// Planes nutricionales (PDF enviado tras la consulta)
// ============================================================
model NutritionPlan {
  id            String   @id @default(cuid())
  patientId     String
  appointmentId String?  @unique
  title         String
  fileUrl       String
  fileMime      String?
  sentAt        DateTime?
  sentBy        SendMethod?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@map("nutrition_plans")
}

enum SendMethod {
  EMAIL
  WHATSAPP
  BOTH
}

// ============================================================
// Log de correos enviados (auditoría y debugging)
// ============================================================
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  template  String      // identificador de template (ej. "appointment-confirmation")
  status    EmailStatus @default(QUEUED)
  error     String?     @db.Text
  // Id que devuelve el proveedor (Resend). Es lo que permite rastrear un
  // correo concreto en su panel cuando hay que investigar una entrega.
  providerMessageId String? @db.VarChar(191)
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([to])
  @@index([template])
  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}
